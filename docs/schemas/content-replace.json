{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cs content --replace output",
  "description": "JSON output schema for 'cs content --replace <replacement>'. Shows pending replacements with old/new line values.",
  "type": "object",
  "required": [
    "tool",
    "version",
    "command",
    "query",
    "source",
    "count",
    "elapsed_secs",
    "dry_run",
    "results"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "const": "codescope"
    },
    "version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "const": "content"
    },
    "query": {
      "type": "string",
      "description": "The search/replace pattern."
    },
    "source": {
      "type": "string",
      "enum": ["filesystem", "stdin", "web"]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of replacements in the results array."
    },
    "elapsed_secs": {
      "type": "number"
    },
    "dry_run": {
      "type": "boolean",
      "description": "true when --write is NOT passed (preview only). false when changes were written to disk."
    },
    "results": {
      "type": "array",
      "description": "Array of replacements (never 'changes' or 'diffs').",
      "items": {
        "type": "object",
        "required": ["file", "path", "line", "old", "new"],
        "properties": {
          "file": {
            "type": "string",
            "description": "File name."
          },
          "path": {
            "type": "string",
            "description": "Full file path."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based line number."
          },
          "old": {
            "type": "string",
            "description": "Original line content."
          },
          "new": {
            "type": "string",
            "description": "Replacement line content."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

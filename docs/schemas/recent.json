{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cs recent output",
  "description": "JSON output schema for the 'cs recent' command. Returns recently modified files as objects (not plain strings).",
  "type": "object",
  "required": [
    "tool",
    "version",
    "command",
    "query",
    "source",
    "count",
    "elapsed_secs",
    "results"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "const": "codescope"
    },
    "version": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "const": "recent"
    },
    "query": {
      "type": "string",
      "description": "The search path or description."
    },
    "source": {
      "type": "string",
      "enum": ["filesystem", "stdin", "web"]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_secs": {
      "type": "number"
    },
    "results": {
      "type": "array",
      "description": "Recently modified files as objects. Each item includes path, modification time, size, and extension.",
      "items": {
        "type": "object",
        "required": ["path", "modified", "size_bytes", "extension"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Full or relative path to the file."
          },
          "modified": {
            "type": "string",
            "description": "ISO 8601 timestamp of last modification, or a human-readable relative time string."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes."
          },
          "extension": {
            "type": "string",
            "description": "File extension without leading dot."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

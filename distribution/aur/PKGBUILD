# Maintainer: Arga Wicaksono <arga@codescope.dev>
pkgname=codescope
pkgver=1.3.0
pkgrel=1
pkgdesc="Repository Intelligence Engine for AI & Developers"
arch=('x86_64' 'aarch64')
url="https://github.com/Arga-Wicaksono/codescope"
license=('MIT')
depends=('gcc-libs')
optdepends=('ollama: for AI-powered rewrite')
conflicts=('codescope-bin' 'codescope-git')
provides=('cs')
source_x86_64=("https://github.com/Arga-Wicaksono/codescope/releases/download/v${pkgver}/cs-x86_64-linux.tar.gz")
source_aarch64=("https://github.com/Arga-Wicaksono/codescope/releases/download/v${pkgver}/cs-aarch64-linux.tar.gz")
sha256sums_x86_64=('REPLACE_WITH_ACTUAL_SHA256')
sha256sums_aarch64=('REPLACE_WITH_ACTUAL_SHA256')

prepare() {
    # Generate shell completions
    if [ -x "${srcdir}/cs" ]; then
        "${srcdir}/cs" completions bash > cs.bash
        "${srcdir}/cs" completions zsh > cs.zsh
        "${srcdir}/cs" completions fish > cs.fish
    fi
}

package() {
    install -Dm755 "${srcdir}/cs" "${pkgdir}/usr/bin/cs"
    install -Dm644 "${srcdir}/cs.bash" "${pkgdir}/usr/share/bash-completion/completions/cs"
    install -Dm644 "${srcdir}/cs.zsh" "${pkgdir}/usr/share/zsh/site-functions/_cs"
    install -Dm644 "${srcdir}/cs.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/cs.fish"
}

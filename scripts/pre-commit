#!/usr/bin/env bash
# CodeScope pre-commit hook
# Runs cargo fmt, cargo clippy, and cargo check before allowing a commit.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

# Source Rust environment
if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# Fallback: check common Rust installation paths
if ! command -v cargo &>/dev/null; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}═══ CodeScope Pre-commit Checks ═══${NC}"

# 1. cargo fmt
echo -e "${CYAN}[1/3] Checking formatting (cargo fmt)...${NC}"
if ! cargo fmt --check 2>&1; then
    echo -e "${YELLOW}Formatting issues found. Running cargo fmt...${NC}"
    cargo fmt
    echo -e "${GREEN}Formatting applied.${NC}"
    # Re-stage formatted files
    git diff --name-only --diff-filter=M | while read -r file; do
        git add "$file"
    done
fi
echo -e "${GREEN}  ✓ Format check passed${NC}"

# 2. cargo check
echo -e "${CYAN}[2/3] Compiling (cargo check)...${NC}"
if ! cargo check 2>&1; then
    echo -e "${RED}  ✗ cargo check failed. Please fix compilation errors before committing.${NC}"
    exit 1
fi
echo -e "${GREEN}  ✓ Compilation check passed${NC}"

# 3. cargo clippy
echo -e "${CYAN}[3/3] Linting (cargo clippy)...${NC}"
if ! cargo clippy -- -D warnings 2>&1; then
    echo -e "${YELLOW}  ⚠ Clippy warnings found (non-blocking)${NC}"
    echo -e "${YELLOW}    Run 'cargo clippy --fix' to auto-fix${NC}"
else
    echo -e "${GREEN}  ✓ Clippy check passed${NC}"
fi

echo -e "${GREEN}═══ All checks passed! ═══${NC}"
exit 0
